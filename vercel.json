{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/security/check-device",
      "destination": "/api/security?action=check-device"
    },
    {
      "source": "/api/security/verify-device",
      "destination": "/api/security?action=verify-device"
    },
    {
      "source": "/api/security/session-status",
      "destination": "/api/security?action=session-status"
    },
    {
      "source": "/api/security/request-password-reset",
      "destination": "/api/security?action=request-password-reset"
    },
    {
      "source": "/api/security/reset-password",
      "destination": "/api/security?action=reset-password"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
